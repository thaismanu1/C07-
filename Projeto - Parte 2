DROP DATABASE IF EXISTS projeto_vendas;
CREATE DATABASE projeto_vendas;
USE projeto_vendas;

CREATE TABLE Pessoa (
    idPessoa INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(100) UNIQUE,
    endereco VARCHAR(150)
);

CREATE TABLE Cliente (
    Pessoa_idPessoa INT PRIMARY KEY,
    data_cadastro DATE NOT NULL,
    CONSTRAINT fk_cliente_pessoa FOREIGN KEY (Pessoa_idPessoa)
        REFERENCES Pessoa(idPessoa)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Funcionario (
    Pessoa_idPessoa INT PRIMARY KEY,
    cargo VARCHAR(50) NOT NULL,
    data_admissao DATE NOT NULL,
    salario DECIMAL(10,2) NOT NULL,
    Funcionario_Pessoa_idPessoa INT NULL,
    CONSTRAINT fk_funcionario_pessoa FOREIGN KEY (Pessoa_idPessoa)
        REFERENCES Pessoa(idPessoa)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_funcionario_supervisor FOREIGN KEY (Funcionario_Pessoa_idPessoa)
        REFERENCES Funcionario(Pessoa_idPessoa)
        ON DELETE SET NULL ON UPDATE CASCADE
);

CREATE TABLE Categoria (
    idCategoria INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(50) NOT NULL,
    descricao VARCHAR(150)
);

CREATE TABLE Produto (
    idProduto INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(100) NOT NULL,
    descricao VARCHAR(255),
    preco DECIMAL(10,2) NOT NULL,
    estoque INT NOT NULL,
    Categoria_idCategoria INT NOT NULL,
    CONSTRAINT fk_produto_categoria FOREIGN KEY (Categoria_idCategoria)
        REFERENCES Categoria(idCategoria)
        ON DELETE RESTRICT ON UPDATE CASCADE
);

CREATE TABLE Fornecedor (
    idFornecedor INT AUTO_INCREMENT PRIMARY KEY,
    razao_social VARCHAR(100) NOT NULL,
    cnpj CHAR(14) NOT NULL UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(100)
);

CREATE TABLE Fornecimento (
    Fornecedor_idFornecedor INT NOT NULL,
    Produto_idProduto INT NOT NULL,
    preco_custo DECIMAL(10,2) NOT NULL,
    prazo_entrega_dias INT NOT NULL,
    PRIMARY KEY (Fornecedor_idFornecedor, Produto_idProduto),
    CONSTRAINT fk_fornecimento_fornecedor FOREIGN KEY (Fornecedor_idFornecedor)
        REFERENCES Fornecedor(idFornecedor)
        ON DELETE CASCADE ON UPDATE CASCADE,
    CONSTRAINT fk_fornecimento_produto FOREIGN KEY (Produto_idProduto)
        REFERENCES Produto(idProduto)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE Pedido (
    idPedido INT AUTO_INCREMENT PRIMARY KEY,
    data_pedido DATETIME NOT NULL,
    valor_total DECIMAL(10,2) NOT NULL,
