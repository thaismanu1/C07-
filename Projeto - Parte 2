SELECT 
    nf.numero AS 'Número NF',
    nf.data_emissao AS 'Data de Emissão',
    p.idPedido AS 'Pedido',
    pes.nome AS 'Cliente',
    pes.cpf AS 'CPF',
    nf.valor_total AS 'Valor Total'
FROM NotaFiscal nf
INNER JOIN Pedido p ON nf.Pedido_idPedido = p.idPedido
INNER JOIN Cliente c ON p.Cliente_Pessoa_idPessoa = c.Pessoa_idPessoa
INNER JOIN Pessoa pes ON c.Pessoa_idPessoa = pes.idPessoa;

SELECT 
    cat.nome AS 'Categoria',
    prod.nome AS 'Produto',
    prod.preco AS 'Preço Unitário',
    prod.estoque AS 'Estoque',
    (prod.preco * prod.estoque) AS 'Total em Estoque'
FROM Categoria cat
INNER JOIN Produto prod ON cat.idCategoria = prod.Categoria_idCategoria;

SELECT 
    pes.nome AS 'Funcionário',
    f.cargo AS 'Cargo',
    p.idPedido AS 'Código Pedido',
    p.status AS 'Status',
    p.valor_total AS 'Valor da Venda'
FROM Funcionario f
INNER JOIN Pessoa pes ON f.Pessoa_idPessoa = pes.idPessoa
INNER JOIN Pedido p ON f.Pessoa_idPessoa = p.Funcionario_Pessoa_idPessoa;

SELECT 
    ped.idPedido AS 'Pedido',
    prod.nome AS 'Produto',
    forn.razao_social AS 'Fornecedor',
    ip.quantidade AS 'Quantidade',
    fornec.preco_custo AS 'Preço de Custo',
    ip.preco_unitario AS 'Preço de Venda'
FROM Pedido ped
INNER JOIN ItemPedido ip ON ped.idPedido = ip.Pedido_idPedido
INNER JOIN Produto prod ON ip.Produto_idProduto = prod.idProduto
INNER JOIN Fornecimento fornec ON prod.idProduto = fornec.Produto_idProduto
INNER JOIN Fornecedor forn ON fornec.Fornecedor_idFornecedor = forn.idFornecedor;

DELIMITER $$
DROP PROCEDURE IF EXISTS AtualizarSalarioFuncionario$$
CREATE PROCEDURE AtualizarSalarioFuncionario(
    IN funcionario_id INT,
    IN percentual_aumento DECIMAL(5,2)
)
BEGIN
    IF percentual_aumento > 0 THEN
        UPDATE Funcionario
        SET salario = salario * (1 + percentual_aumento / 100)
        WHERE Pessoa_idPessoa = funcionario_id;
        
        SELECT 'Salário atualizado com sucesso!' AS Resultado;
    ELSE
        SELECT 'Percentual inválido! Informe um valor maior que zero.' AS Resultado;
    END IF;
END$$
DELIMITER ;

CALL AtualizarSalarioFuncionario(7, 10.0);

DELIMITER $$
DROP FUNCTION IF EXISTS calcular_lucro_item$$
CREATE FUNCTION calcular_lucro_item(preco_venda DECIMAL(10,2), preco_custo DECIMAL(10,2), qtd INT)
RETURNS DECIMAL(10,2)
DETERMINISTIC
BEGIN
    RETURN (preco_venda - preco_custo) * qtd;
END$$
DELIMITER ;

SELECT 
    Pedido_idPedido AS 'Pedido',
    Produto_idProduto AS 'ID Produto',
    quantidade AS 'Qtd',
    preco_unitario AS 'Preço Venda',
    calcular_lucro_item(preco_unitario, 200.00, quantidade) AS 'Lucro Estimado'
FROM ItemPedido;

CREATE OR REPLACE VIEW vendas_detalhadas AS (
    SELECT 
        p.idPedido AS 'Pedido',
        pes_cli.nome AS 'Cliente',
        prod.nome AS 'Produto',
        ip.quantidade AS 'Quantidade',
        ip.preco_unitario AS 'Preço Unitário',
        (ip.quantidade * ip.preco_unitario) AS 'Total da Venda'
    FROM Pedido p
    INNER JOIN Cliente c ON p.Cliente_Pessoa_idPessoa = c.Pessoa_idPessoa
    INNER JOIN Pessoa pes_cli ON c.Pessoa_idPessoa = pes_cli.idPessoa
    INNER JOIN ItemPedido ip ON p.idPedido = ip.Pedido_idPedido
    INNER JOIN Produto prod ON ip.Produto_idProduto = prod.idProduto
);

SELECT * FROM vendas_detalhadas;

DELIMITER $$
DROP TRIGGER IF EXISTS trg_baixa_estoque$$
CREATE TRIGGER trg_baixa_estoque AFTER INSERT
ON ItemPedido
FOR EACH ROW
BEGIN
    UPDATE Produto
    SET estoque = estoque - NEW.quantidade
    WHERE idProduto = NEW.Produto_idProduto;
END$$
DELIMITER ;

