DROP TRIGGER IF EXISTS desconto_check_pedido$$
CREATE TRIGGER desconto_check_pedido BEFORE UPDATE
ON Pedido
FOR EACH ROW
BEGIN
    IF NEW.valor_total > 1500.00 THEN
        SET NEW.valor_total = NEW.valor_total * 0.9;
    END IF;
END$$
DELIMITER ;

